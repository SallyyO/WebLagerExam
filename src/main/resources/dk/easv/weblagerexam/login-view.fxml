<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1020.0" style="-fx-background-color: linear-gradient(to bottom right, #faf5ff, #fdf2f8);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.weblagerexam.gui.LoginController">

    <!-- ================= HEADER ================= -->
    <top>
        <fx:include source="/dk/easv/weblagerexam/header-view.fxml"/>
    </top>

    <!-- ================= CENTER (Login) ================= -->
    <center>
        <StackPane>
            <VBox alignment="TOP_CENTER" spacing="32">
                <padding>
                    <Insets bottom="24" left="24" right="24" top="24" />
                </padding>

                <!-- HEADER -->
                <VBox alignment="CENTER" spacing="12">
                    <Label text="Lun's  Archive" styleClass="text-h1"/>
                    <Label text="Ts'ai Lun created the first piece of paper. Now we keep yours safe"
                           styleClass="text-body"/>
                </VBox>

                <!-- Spacer to push form toward center -->
                <Region VBox.vgrow="ALWAYS" />
                <Label fx:id="lblErr"
                       text="(Error)"
                       visible="false"
                       styleClass="validation-error text-body"/>

                <!-- LOGIN CARD -->
                <VBox alignment="TOP_LEFT"
                      maxWidth="500"
                      spacing="24"
                      styleClass="card radius-md">
                    <padding>
                        <Insets bottom="24" left="24" right="24" top="24" />
                    </padding>

                    <!-- Username Field -->
                    <VBox spacing="8">
                        <Label text="Email" styleClass="label-medium"/>
                        <TextField fx:id="txtUsernameField"
                                   prefHeight="30"
                                   promptText="Please enter your email"
                                   styleClass="text-field"/>
                    </VBox>

                    <!-- Password Field -->
                    <VBox spacing="8">
                        <Label text="Password" styleClass="label-medium"/>
                        <PasswordField fx:id="txtPasswordField"
                                       prefHeight="30"
                                       promptText="************"
                                       styleClass="text-field"/>
                    </VBox>

                    <!-- Buttons -->
                    <Button fx:id="btnLogIn"
                            text="Sign In"
                            disable="true"
                            onAction="#btnSignIn"
                            maxWidth="Infinity"
                            prefHeight="30"
                            styleClass="button button-primary text-button"
                            HBox.hgrow="ALWAYS"/>

                    <!-- Forgot Password -->
                    <HBox alignment="CENTER">
                        <Hyperlink style="-fx-text-fill: #1e1e1e;" text="Forgot password?" />
                    </HBox>
                </VBox>

                <!-- Spacer bottom -->
                <Region VBox.vgrow="ALWAYS" />
            </VBox>
        </StackPane>
    </center>

</BorderPane>
