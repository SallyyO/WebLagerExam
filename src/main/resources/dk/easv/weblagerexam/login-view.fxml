<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1020.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.weblagerexam.gui.LoginController">

    <!-- Header -->
    <top>
        <fx:include source="/dk/easv/weblagerexam/header-view.fxml"/>
    </top>

    <!-- Center login -->
    <center>
        <StackPane>
            <VBox alignment="TOP_CENTER" spacing="30">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>


                <VBox alignment="CENTER" spacing="12">
                    <Label prefHeight="27.0" prefWidth="165.0" styleClass="text-h1" text="Lun's  Archive" />
                    <Label styleClass="text-h2" text="Ts'ai Lun created the first piece of paper. Now we keep yours safe" />
                </VBox>

                <!-- Spacer to push form toward center -->
                <Region styleClass="spacing-sm" VBox.vgrow="ALWAYS" />
                <Label fx:id="lblErr" styleClass="validation-error text-body" text="(Error)" visible="false" />

                <!-- LOGIN CARD -->
                <VBox alignment="TOP_LEFT" maxWidth="500" spacing="24" styleClass="card radius-md">
                    <padding>
                        <Insets bottom="24" left="24" right="24" top="24" />
                    </padding>

                    <!-- Username Field -->
                    <VBox spacing="8">
                        <Label styleClass="label-medium" text="Initials" />
                        <TextField fx:id="txtUsernameField" prefHeight="30" promptText="Please enter your initials" styleClass="text-field" />
                    </VBox>

                    <!-- Password Field -->
                    <VBox spacing="8">
                        <Label styleClass="label-medium" text="Password" />
                        <PasswordField fx:id="txtPasswordField" prefHeight="30" promptText="************" styleClass="text-field" />
                    </VBox>

                    <!-- Buttons -->
                    <Button fx:id="btnLogIn"
                            disable="true"
                            defaultButton="true"
                            maxWidth="Infinity"
                            onAction="#btnSignIn"
                            styleClass="button-primary"
                            prefHeight="30"
                            text="Sign In"
                            HBox.hgrow="ALWAYS">
                    </Button>

                    <!-- Forgot Password -->
                    <HBox alignment="CENTER">
                        <Hyperlink style="-fx-text-fill: #1e1e1e;" styleClass="text-helper" text="Forgot password?" />
                    </HBox>
                </VBox>

                <!-- Spacer bottom -->
                <Region styleClass="spacing-sm" VBox.vgrow="ALWAYS" />
            </VBox>
        </StackPane>
    </center>

</BorderPane>
