<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1020.0" stylesheets="@CSS/app.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.weblagerexam.gui.LoginController">

    <!-- ================= HEADER ================= 
    <top>
        <fx:include source="/dk/easv/weblagerexam/header-view.fxml"/>
    </top>
    -->

    <!-- ================= CENTER (Login) ================= -->
    <center>
        <StackPane>
            <VBox alignment="TOP_CENTER" spacing="30">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>


                <VBox alignment="CENTER" spacing="12">
                    <Label prefHeight="27.0" prefWidth="165.0" styleClass="text-h1" stylesheets="@CSS/app.css" text="Lun's  Archive" />
                    <Label styleClass="text-h2" stylesheets="@CSS/app.css" text="Ts'ai Lun created the first piece of paper. Now we keep yours safe" />
                </VBox>

                <!-- Spacer to push form toward center -->
                <Region styleClass="spacing-sm" stylesheets="@CSS/app.css" VBox.vgrow="ALWAYS" />
                <Label fx:id="lblErr" styleClass="validation-error text-body" text="(Error)" visible="false" />

                <!-- LOGIN CARD -->
                <VBox alignment="TOP_LEFT" maxWidth="500" spacing="24" styleClass="card radius-md">
                    <padding>
                        <Insets bottom="24" left="24" right="24" top="24" />
                    </padding>

                    <!-- Username Field -->
                    <VBox spacing="8">
                        <Label styleClass="label-medium" text="Email" />
                        <TextField fx:id="txtUsernameField" prefHeight="30" promptText="Please enter your email" styleClass="text-field" stylesheets="@CSS/app.css" />
                    </VBox>

                    <!-- Password Field -->
                    <VBox spacing="8">
                        <Label styleClass="label-medium" stylesheets="@CSS/app.css" text="Password" />
                        <PasswordField fx:id="txtPasswordField" prefHeight="30" promptText="************" styleClass="text-field" stylesheets="@CSS/app.css" />
                    </VBox>

                    <!-- Buttons -->
                    <Button fx:id="btnLogIn" disable="true" maxWidth="Infinity" onAction="#btnSignIn" prefHeight="30" stylesheets="@CSS/app.css" text="Sign In" HBox.hgrow="ALWAYS">
                  <styleClass>
                     <String fx:value="button" />
                     <String fx:value="button-primary" />
                     <String fx:value="text-button" />
                  </styleClass></Button>

                    <!-- Forgot Password -->
                    <HBox alignment="CENTER">
                        <Hyperlink style="-fx-text-fill: #1e1e1e;" styleClass="text-helper" stylesheets="@CSS/app.css" text="Forgot password?" />
                    </HBox>
                </VBox>

                <!-- Spacer bottom -->
                <Region styleClass="spacing-sm" stylesheets="@CSS/app.css" VBox.vgrow="ALWAYS" />
            </VBox>
        </StackPane>
    </center>

</BorderPane>
