<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.ImageView?>
<BorderPane prefHeight="350" prefWidth="400" style="-fx-background-color: #ffffff;" stylesheets="@CSS/app.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.weblagerexam.gui.AddNewUserController">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60" styleClass="modal-header">
            <padding>
                <Insets left="20" />
            </padding>
            <ImageView fitHeight="30" preserveRatio="true">
                <image>
                    <Image url="@/Images/LogoBlueH.png" />
                </image>
            </ImageView>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Add New User" styleClass="text-h3"/>
        </HBox>
    </top>

    <!-- CENTER FORM -->
    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20;">

            <TextField fx:id="txtUsername" prefWidth="250" promptText="Username" stylesheets="@CSS/app.css" />

            <TextField fx:id="txtEmail" prefWidth="250" promptText="Email" />

            <PasswordField fx:id="txtPassword" prefWidth="250" promptText="Password" />

            <ComboBox fx:id="roleComboBox" prefWidth="250" promptText="Select role" stylesheets="@CSS/app.css" />
        </VBox>
    </center>

    <!-- BOTTOM BUTTONS -->
    <bottom>
        <HBox alignment="CENTER" prefHeight="70" spacing="20" styleClass="modal-footer">

            <Button fx:id="btnSave" onAction="#onSaveClicked" prefWidth="120" styleClass="button-secondary" text="Save" />

            <Button fx:id="btnCancel" onAction="#onCancelClicked" prefWidth="120" styleClass="button-primary" text="Cancel" />
        </HBox>
    </bottom>
</BorderPane>
