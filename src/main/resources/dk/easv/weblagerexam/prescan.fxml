<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane prefWidth="420"
            styleClass="modal"
            stylesheets="@CSS/app.css"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="dk.easv.weblagerexam.gui.PreScanController">

    <!-- Header -->
    <top>
        <VBox>

            <!-- HEADER BAR -->
            <HBox alignment="CENTER_LEFT"
                  prefHeight="60"
                  styleClass="modal-header">

                <padding>
                    <Insets left="20"/>
                </padding>

                <!-- Logo -->
                <ImageView fitHeight="30"
                           preserveRatio="true">

                    <image>
                        <Image url="@/Images/LogoBlueH.png"/>
                    </image>

                </ImageView>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Title -->
                <Label text="Ready to scan?"
                       styleClass="text-h3"/>
            </HBox>
        </VBox>
    </top>

    <!-- Form body -->
    <center>
        <VBox styleClass="modal-content" spacing="18">
            <Label text="Please set a Box ID and choose a profile before scanning :)"
                   styleClass="text-helper"
                   wrapText="true"
                   style="-fx-padding: 0 20 10 20;"/>

            <padding><Insets top="12" right="0" bottom="0" left="0"/></padding>

            <!-- Box ID -->
            <VBox spacing="6">
                <Label text="Box ID" styleClass="label-medium"/>
                <TextField fx:id="txtBoxId" promptText="e.g. 1042"/>
                <Label fx:id="lblBoxError" styleClass="error"
                       text="" visible="false" managed="false"/>
            </VBox>

            <!-- Profile selection -->
            <VBox spacing="6">
                <Label text="Profile" styleClass="label-medium"/>
                <Label text="Optional — applies settings to all scanned files."
                       styleClass="text-helper"/>
                <ComboBox fx:id="cmbProfile"
                          promptText="No profile selected"
                          maxWidth="Infinity"/>
            </VBox>

        </VBox>
    </center>

    <!-- Footer buttons -->
    <bottom>
        <HBox styleClass="modal-footer" spacing="9" alignment="CENTER_RIGHT">
            <Button text="Cancel" onAction="#cancel"
                    styleClass="button, button-tertiary"/>
            <Button fx:id="btnStart" text="Start Scanning" onAction="#confirm"
                    styleClass="button, button-primary"/>
        </HBox>
    </bottom>

</BorderPane>