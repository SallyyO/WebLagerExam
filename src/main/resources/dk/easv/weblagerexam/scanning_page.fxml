<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.ProgressBar?>

<BorderPane prefWidth="1200" prefHeight="800"
            stylesheets="@CSS/app.css"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="dk.easv.weblagerexam.gui.ScanningController">

    <top>
        <VBox>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" prefHeight="70" styleClass="modal-header" stylesheets="@CSS/app.css">
                <padding>
                    <Insets bottom="0" left="20" right="24" top="0" />
                </padding>
                <ImageView fitHeight="50.0" fitWidth="203.0">
                    <image>
                        <Image url="@/Images/LogoBlueH.png" />
                    </image>
                </ImageView>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Admin profile area -->
                <HBox fx:id="userBox" alignment="CENTER" spacing="12">
                    <Label fx:id="lblUsername"
                           styleClass="text-h3">
                        <font>
                            <Font name="System" size="15" />
                        </font>
                    </Label>

                    <!-- Avatar circle -->
                    <StackPane>
                        <Circle radius="24" styleClass="avatar-circle" />
                        <Label fx:id="lblInitials"
                               styleClass="avatar-text">
                            <font>
                                <Font name="System Bold" size="13" />
                            </font>
                        </Label>
                    </StackPane>
                </HBox>
            </HBox>


            <!-- Scanning tools -->
            <HBox alignment="CENTER_LEFT" styleClass="gap-sm"
                  style="-fx-padding: 9 16 9 16;
                         -fx-border-color: #E2E4E8;
                         -fx-border-width: 0 0 1 0;
                         -fx-background-color: white;">

                <Button text="← Back"
                        onAction="#onBackClicked"
                        styleClass="btn-primary"/>

                <Button fx:id="btnStartScan"
                        text="Start Scan"
                        onAction="#startScan"
                        styleClass="button, button-primary"/>

                <Button fx:id="btnPauseScan"
                        text="Pause"
                        onAction="#pauseScan"
                        disable="true"
                        styleClass="button, button-secondary"/>

                <Button fx:id="btnStopScan"
                        text="Stop"
                        onAction="#stopScan"
                        disable="true"
                        styleClass="button, button-danger"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblStatus"
                       text="Ready"
                       styleClass="text-helper"/>

                <!-- Skeleton-style loading bar — hidden until scanning starts -->
                <ProgressBar fx:id="progressBar"
                             prefWidth="200"
                             prefHeight="8"
                             progress="-1"
                             visible="false"
                             managed="false"/>

            </HBox>
        </VBox>
    </top>

    <left>
        <VBox style="-fx-background-color: #F9F9F9;
                     -fx-border-color: #E2E4E8;
                     -fx-border-width: 0 1 0 0;"
              prefWidth="200">

            <!-- Header row with refresh button -->
            <HBox alignment="CENTER_LEFT" spacing="6"
                  style="-fx-padding: 10 10 6 10;
                         -fx-border-color: #E2E4E8;
                         -fx-border-width: 0 0 1 0;">
                <Label text="Navigator" styleClass="label-medium"
                       style="-fx-font-weight: 600;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRefreshTree" text="↻"
                        onAction="#refreshTree"
                        styleClass="button, button-tertiary"
                        style="-fx-pref-width: 28; -fx-pref-height: 28;
                               -fx-font-size: 14px;"
                        prefWidth="28" prefHeight="28"/>
            </HBox>

            <!-- Scrollable tree -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;">
                <VBox fx:id="treeContainer"
                      style="-fx-padding: 6;"/>
            </ScrollPane>
        </VBox>
    </left>

    <!-- main preview, scrollable-->
    <center>
        <ScrollPane fx:id="mainScrollPane"
                    fitToWidth="false"
                    fitToHeight="false"
                    pannable="true"
                    style="-fx-background-color: #F1F5F9;
                           -fx-background: #F1F5F9;">
            <StackPane fx:id="mainImageContainer"
                       style="-fx-background-color: #F1F5F9;
                              -fx-min-width: 600;
                              -fx-min-height: 700;
                              -fx-alignment: center;">
                <ImageView fx:id="mainPreview"
                           preserveRatio="true"
                           fitWidth="600"
                           fitHeight="700"/>
            </StackPane>
        </ScrollPane>
    </center>

    <!-- Sidebar with thumbnails, pdf style -->
    <right>
        <ScrollPane fitToWidth="true"
                    prefWidth="164"
                    vbarPolicy="AS_NEEDED"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: #F9F9F9;
                           -fx-background: #F9F9F9;
                           -fx-border-color: #E2E4E8;
                           -fx-border-width: 0 0 0 1;">
            <VBox fx:id="thumbnailContainer"
                  styleClass="gap-sm"
                  style="-fx-padding: 10;"/>
        </ScrollPane>
    </right>
</BorderPane>