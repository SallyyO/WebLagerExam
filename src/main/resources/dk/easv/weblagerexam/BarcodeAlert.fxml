<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import java.lang.String?>

<VBox prefWidth="420"
      style="-fx-background-color: #ffffff;"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dk.easv.weblagerexam.gui.BarcodeAlertController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT"
          prefHeight="60"
          styleClass="modal-header"
          stylesheets="@CSS/app.css">
        <padding>
            <Insets bottom="0" left="20" right="20" top="0"/>
        </padding>
        <Label text="Duplicate Barcode Detected"
               styleClass="text-h3"
               stylesheets="@CSS/app.css">
            <font>
                <Font name="System Bold" size="16"/>
            </font>
        </Label>
    </HBox>

    <!-- BODY -->
    <VBox spacing="15" style="-fx-background-color: #ffffff;">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20"/>
        </padding>

        <!-- Warning box -->
        <VBox spacing="8"
              style="-fx-background-color: #FFF5F5;
                     -fx-padding: 12;
                     -fx-border-color: #FFCCCC;
                     -fx-border-width: 1;
                     -fx-border-radius: 6;
                     -fx-background-radius: 6;">

            <!-- Barcode value -->
            <Label fx:id="barcodeValueLabel"
                   text="Barcode: "
                   styleClass="text-body"
                   stylesheets="@CSS/app.css"
                   style="-fx-font-weight: bold;">
                <font>
                    <Font name="System Bold" size="13"/>
                </font>
            </Label>

            <!-- Description -->
            <Label text="This barcode has already been scanned and exists in the system."
                   styleClass="text-body"
                   stylesheets="@CSS/app.css"
                   wrapText="true">
                <font>
                    <Font name="System" size="13"/>
                </font>
            </Label>
        </VBox>

        <!-- Helper text -->
        <Label text="Please check if this document has already been processed before continuing."
               styleClass="text-helper"
               stylesheets="@CSS/app.css"
               wrapText="true">
            <font>
                <Font name="System" size="12"/>
            </font>
        </Label>

    </VBox>

    <!-- FOOTER BUTTONS -->
    <Region VBox.vgrow="ALWAYS"/>
    <HBox alignment="CENTER"
          prefHeight="70"
          spacing="20"
          styleClass="modal-footer"
          stylesheets="@CSS/app.css">
        <padding>
            <Insets bottom="15" left="20" right="20" top="15"/>
        </padding>

        <Button fx:id="btnContinue"
                text="Continue Anyway"
                onAction="#onContinueClicked"
                prefHeight="30"
                prefWidth="160"
                stylesheets="@CSS/app.css">
            <font>
                <Font name="System Bold" size="13"/>
            </font>
            <styleClass>
                <String fx:value="button-primary"/>
                <String fx:value="text-button"/>
            </styleClass>
        </Button>

        <Button fx:id="btnStop"
                text="Stop Scanning"
                onAction="#onStopClicked"
                prefHeight="30"
                prefWidth="160"
                stylesheets="@CSS/app.css">
            <font>
                <Font name="System Bold" size="13"/>
            </font>
            <styleClass>
                <String fx:value="button-secondary"/>
                <String fx:value="text-button"/>
            </styleClass>
        </Button>

    </HBox>

</VBox>