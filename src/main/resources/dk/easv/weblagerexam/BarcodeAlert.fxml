<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="420.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.weblagerexam.gui.BarcodeAlertController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" prefHeight="60" styleClass="modal-header" stylesheets="@CSS/app.css">
        <padding>
            <Insets bottom="0" left="20" right="20" top="0" />
        </padding>
        <Label styleClass="text-h3" stylesheets="@CSS/app.css" text="Barcode has already been scanned">
            <font>
                <Font name="System Bold" size="16" />
            </font>
        </Label>
    </HBox>

    <!-- BODY -->
    <VBox spacing="15" style="-fx-background-color: #ffffff;">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- Warning box -->
        <VBox spacing="8" style="-fx-background-color: #FFF5F5;                      -fx-padding: 12;                      -fx-border-color: #FFCCCC;                      -fx-border-width: 1;                      -fx-border-radius: 6;                      -fx-background-radius: 6;">

            <!-- Barcode value -->
            <Label fx:id="barcodeValueLabel" style="-fx-font-weight: bold;" styleClass="text-body" stylesheets="@CSS/app.css" text="Barcode: ">
                <font>
                    <Font name="System Bold" size="13" />
                </font>
            </Label>


            <Label styleClass="text-body" stylesheets="@CSS/app.css" text="This barcode has already been scanned and exists in the system" wrapText="true">
                <font>
                    <Font name="System" size="13" />
                </font>
            </Label>
        </VBox>

        <Label styleClass="text-helper" stylesheets="@CSS/app.css" text="Please check if this document has already been scanned before continuing." wrapText="true">
            <font>
                <Font name="System" size="12" />
            </font>
        </Label>

    </VBox>


    <Region VBox.vgrow="ALWAYS" />
    <HBox alignment="CENTER" prefHeight="70.0" prefWidth="436.0" spacing="20" styleClass="modal-footer" stylesheets="@CSS/app.css">
        <padding>
            <Insets bottom="15" left="20" right="20" top="15" />
        </padding>

        <Button fx:id="btnStop" onAction="#onStopClicked" prefHeight="30" prefWidth="160" stylesheets="@CSS/app.css" text="Stop Scanning [ S ]">
            <font>
                <Font name="System Bold" size="13" />
            </font>
            <styleClass>
                <String fx:value="button-secondary" />
                <String fx:value="text-button" />
            </styleClass>
        </Button>

        <Button fx:id="btnContinue" onAction="#onContinueClicked" prefHeight="30" prefWidth="160" stylesheets="@CSS/app.css" text="Continue [ ENTER ]" HBox.hgrow="ALWAYS">
            <font>
                <Font name="System Bold" size="13" />
            </font>
            <styleClass>
                <String fx:value="button-primary" />
                <String fx:value="text-button" />
            </styleClass>
        </Button>

    </HBox>
    <HBox alignment="CENTER" style="-fx-padding: 0 0 12 0;">
        <ImageView fitWidth="80" preserveRatio="true">
            <image>
                <Image url="@/Images/LogoBlueH.png" />
            </image>
        </ImageView>
    </HBox>

</VBox>
