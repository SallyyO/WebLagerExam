<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #ffffff;"
      prefWidth="350"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="dk.easv.weblagerexam.gui.AddUserController">

    <!-- Title -->
    <Label text="Add New User" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <!-- Username -->
    <VBox spacing="5">
        <Label text="Username"/>
        <TextField fx:id="nameTxt" promptText="Enter username"/>
    </VBox>

    <!-- Email -->
    <VBox spacing="5">
        <Label text="Email"/>
        <TextField fx:id="emailTxt" promptText="Enter email"/>
    </VBox>

    <!-- Password -->
    <VBox spacing="5">
        <Label text="Password"/>
        <PasswordField fx:id="passwordTxt" promptText="Enter password"/>
    </VBox>

    <!-- Role -->
    <VBox spacing="5">
        <Label text="Role"/>
        <ComboBox fx:id="cbRole" maxWidth="Infinity"/>
    </VBox>

    <!-- Buttons -->
    <HBox spacing="10">
        <Button text="Add User"
                onAction="#btnAddUser"
                maxWidth="Infinity"
                HBox.hgrow="ALWAYS"/>
        <Button text="Cancel"
                onAction="#btnCancel"
                maxWidth="Infinity"
                HBox.hgrow="ALWAYS"/>
    </HBox>

</VBox>