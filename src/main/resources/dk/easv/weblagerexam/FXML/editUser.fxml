<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-padding: 20;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="dk.easv.weblagerexam.gui.EditUserControllers">

    <Label fx:id="userNameLabel" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <HBox spacing="20">

        <VBox spacing="5">
            <Label text="Available Profiles"/>
            <ListView fx:id="availableProfilesListView" prefHeight="200" prefWidth="200"/>
            <Button text="Assign →" onAction="#handleAssignProfile" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Assigned Profiles"/>
            <ListView fx:id="assignedProfilesListView" prefHeight="200" prefWidth="200"/>
            <Button text="← Remove" onAction="#handleRemoveProfile" maxWidth="Infinity"/>
        </VBox>

    </HBox>

    <Button text="Close" onAction="#handleClose" maxWidth="Infinity"/>

</VBox>