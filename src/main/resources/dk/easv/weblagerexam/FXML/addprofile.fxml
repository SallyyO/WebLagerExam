<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-padding: 20;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="dk.easv.weblagerexam.gui.AddProfileController">

    <Label text="Create New Profile" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <TextField fx:id="profileNameField" promptText="Profile name"/>

    <Button text="Add Profile" onAction="#handleAddProfile"
            maxWidth="Infinity"/>

</VBox>