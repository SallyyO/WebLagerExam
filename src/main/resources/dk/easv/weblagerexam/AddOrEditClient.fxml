<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<BorderPane prefHeight="500.0"
            prefWidth="450.0"
            style="-fx-background-color: #ffffff;"
            stylesheets="@CSS/app.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dk.easv.weblagerexam.gui.AddOrEditClientController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="60"
              styleClass="modal-header">

            <padding>
                <Insets left="20"/>
            </padding>

            <ImageView fitHeight="30"
                       preserveRatio="true">
                <image>
                    <Image url="@/Images/LogoBlueH.png"/>
                </image>
            </ImageView>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblTitle"
                   text="Client"
                   styleClass="text-h3"/>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>

        <VBox spacing="15"
              alignment="CENTER"
              style="-fx-padding: 20;">

            <TextField fx:id="txtClientName"
                       prefWidth="250"
                       promptText="Client Name"/>

            <ComboBox fx:id="cmbStatus"
                      prefWidth="250"/>

            <Separator/>

            <Label text="Profiles"/>

            <HBox spacing="10"
                  alignment="CENTER">

                <ListView fx:id="availableProfilesListView"
                          prefHeight="180"
                          prefWidth="150"/>

                <VBox spacing="5">

                    <Button text="Assign →"
                            onAction="#handleAssignProfile"/>

                    <Button text="← Remove"
                            onAction="#handleRemoveProfile"/>

                </VBox>

                <ListView fx:id="assignedProfilesListView"
                          prefHeight="180"
                          prefWidth="150"/>

            </HBox>

        </VBox>

    </center>

    <!-- FOOTER -->
    <bottom>

        <HBox alignment="CENTER"
              spacing="20"
              prefHeight="70"
              styleClass="modal-footer">

            <Button fx:id="btnCancel"
                    text="Cancel [ESC]"
                    prefWidth="120"
                    styleClass="button-primary"
                    onAction="#onCancelClicked"/>

            <Button fx:id="btnSave"
                    text="Save [ENTER]"
                    prefWidth="120"
                    styleClass="button-secondary"
                    onAction="#onSaveClicked"/>

        </HBox>

    </bottom>

</BorderPane>
